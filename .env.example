; Copy this file to .env and fill in the real values. Never commit .env or real keys.
GOOGLE_VISION_API_KEY=your-google-vision-api-key
GEMINI_API_KEY=your-gemini-api-key
GOOGLE_CLIENT_ID=your-google-oauth-client-id
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret
APP_URL=http://localhost/scholarlink
; Optional: address used in emailed links when you open ScholarLink as "localhost" (default: this PC's Wi-Fi/LAN IP)
; LAN_URL=http://192.168.1.36/scholarlink

; Outgoing email - Gmail app password from https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-address@gmail.com
SMTP_PASSWORD=your-16-character-app-password
SMTP_FROM=your-address@gmail.com
SMTP_FROM_NAME="TAU ScholarLink - OSSD"
; 1 skips SSL certificate checks, only needed on XAMPP without a CA bundle. Use 0 on the live server.
SMTP_ALLOW_SELF_SIGNED=0
